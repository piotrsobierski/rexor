APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8081
APP_PORT=8081
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_FORWARD_PORT=3307
DB_NAME=rexor_configurator
DB_USER=rexor
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-root-local
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=rexor_configurator;charset=utf8mb4

MAIL_TRANSPORT=log
# Na home.pl można użyć `mail`, jeżeli funkcja PHP mail() jest aktywna.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@rexorbikes.com
MAIL_FROM_NAME=Rexor Bikes
QUOTE_RECIPIENT=

MEDIA_DIR=storage/media
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30

# Wymagane tylko do świadomego uruchomienia migracji na produkcji.
MIGRATION_ALLOW_PRODUCTION=0

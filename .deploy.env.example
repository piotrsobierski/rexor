# Host FTP/FTPS podany w panelu operatora hostingu, bez protokołu.
DEPLOY_FTP_HOST=replace-with-ftp-host
DEPLOY_FTP_USER=replace-with-ftp-user
DEPLOY_FTP_PASSWORD=replace-with-ftp-password

# Dla konta z katalogiem public_html widocznym po zalogowaniu.
DEPLOY_REMOTE_DIR=/public_html
DEPLOY_BASE_URL=https://rexor.sobierski.com
DEPLOY_MIGRATION_TOKEN=replace-with-random-secret
DEPLOY_BACKUP_TOKEN=replace-with-another-random-secret

Options -Indexes
DirectoryIndex index.html

# Eksport statyczny tworzy jednocześnie rowery.html i katalog rowery/ (podstrony).
# Z domyślnym DirectorySlash Apache przechwytuje /rowery i robi 301 na /rowery/,
# czyli na katalog bez index.html -> 403, zanim reguła mapująca na .html zdąży zadziałać.
DirectorySlash Off

RewriteEngine On

# Za Cloudflare/proxy respektujemy nagłówek oryginalnego protokołu.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Jedyny publiczny backend aplikacji to router PHP.
RewriteRule ^api(?:/.*)?$ apps/api/public/index.php [QSA,L]

# Kod aplikacji, SQL, sekrety i backupy nie mogą być pobierane przez WWW.
# remote-backup.php tylko WYZWALA zrzut (zapisuje go pod storage/backups/),
# nie serwuje go - storage/backups zostaje zablokowany jak wyżej, pobranie
# idzie przez FTP w scripts/download-db-backup.sh.
RewriteCond %{THE_REQUEST} \s/+(.*/)?(?:apps|database|scripts|storage/backups)(?:[/\s?]) [NC]
RewriteCond %{REQUEST_URI} !^/scripts/remote-(migrate|backup)\.php$ [NC]
RewriteRule ^ - [F,L]

<FilesMatch "(^\.|\.env|\.(sql|log|ini|sh)$)">
  Require all denied
</FilesMatch>

# Dynamiczne tokeny korzystają z jednego statycznie wyeksportowanego shella.
RewriteRule ^konfiguracja/[^/]+/?$ konfiguracja/_.html [L]
RewriteRule ^admin/konfiguracje/[^/]+/?$ admin/konfiguracje/_.html [L]

# Strona modelu roweru: modele/ramy dochodzą tylko z bazy (panel admina),
# więc nie może być z góry ustalonej listy kategoria/model - jak wyżej,
# jeden shell, właściwy slug BikeModelPage czyta z URL-a po stronie klienta.
RewriteRule ^rowery/[^/]+/[^/]+/?$ rowery/_/_.html [L]

# Ramy i realizacje: pod tymi katalogami nie ma żadnej wyeksportowanej
# podstrony poza powłoką, więc reguła może być bezwarunkowa. Wzorzec wymaga
# ukośnika i segmentu, więc same /ramy i /realizacje tu nie wpadają i trafiają
# niżej, do mapowania na ramy.html / realizacje.html.
RewriteRule ^ramy/[^/]+/?$ ramy/_.html [L]
RewriteRule ^realizacje/[^/]+/?$ realizacje/_.html [L]

# Kategoria roweru. Tu, inaczej niż wyżej, część kategorii MA wyeksportowaną
# stronę (te znane w chwili builda) - najpierw więc próbujemy pliku .html,
# a dopiero gdy go nie ma, schodzimy na powłokę. Bez tej kolejności nowa
# kategoria z panelu dostawała 404, a stare kategorie traciłyby render
# serwerowy na rzecz dociągania danych w przeglądarce.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(rowery/[^/]+?)/?$ $1.html [L]
RewriteRule ^rowery/[^/]+/?$ rowery/_.html [L]

# Trasy eksportu statycznego są zapisane jako nazwa.html.
# DOCUMENT_ROOT zamiast REQUEST_FILENAME, żeby /trasa i /trasa/ trafiały tak samo.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

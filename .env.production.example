APP_ENV=production
APP_DEBUG=0
APP_URL=https://rexor.example.com
FRONTEND_URL=https://rexor.example.com
CORS_ORIGIN=https://rexor.example.com

DB_HOST=replace-with-homepl-mysql-host
DB_PORT=3306
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-strong-secret
DB_DSN=mysql:host=replace-with-homepl-mysql-host;port=3306;dbname=replace-with-database-name;charset=utf8mb4

MAIL_TRANSPORT=smtp
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-strong-secret
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@rexorbikes.com
MAIL_FROM_NAME=Rexor Bikes
QUOTE_RECIPIENT=replace-with-sales-address

MEDIA_DIR=storage/media
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30

# Losowy sekret używany tylko przez jednorazowy runner migracji FTP.
DEPLOY_MIGRATION_TOKEN=replace-with-random-secret
DEPLOY_BACKUP_TOKEN=replace-with-another-random-secret

# Ustawić na 1 tylko na czas świadomego wdrożenia po sprawdzonym backupie.
MIGRATION_ALLOW_PRODUCTION=0
